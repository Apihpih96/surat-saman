# Copy to .env.local and fill in. Values from Firebase console > Project settings > Your apps (Web).
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=surat-saman.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=surat-saman
VITE_FIREBASE_STORAGE_BUCKET=surat-saman.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# App Check (required by Firebase AI Logic).
# Production: reCAPTCHA Enterprise site key (or a v3 key with VITE_APPCHECK_PROVIDER=v3)
VITE_RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_SITE_KEY
VITE_APPCHECK_PROVIDER=enterprise
# Local dev only (never in production builds): a debug token registered in
# Firebase console > App Check > Apps > Manage debug tokens, or "true" to print a new one in the console.
VITE_APPCHECK_DEBUG_TOKEN=

# Optional: override the cloud model (SDK default is gemini-3.5-flash-lite)
VITE_CLOUD_MODEL=
